{
  "version": 6,
  "configurePresets": [
    {
      "binaryDir": "${sourceDir}/build/${presetName}",
      "name": "release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_FLAGS": "-fno-tree-vectorize -fopenmp"
      }
    },
    {
      "binaryDir": "${sourceDir}/build/${presetName}",
      "name": "debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_FLAGS": "-fno-tree-vectorize -fopenmp"
      }
    }
  ]
}