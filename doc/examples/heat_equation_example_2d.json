{
  "dimension": 2,
  "output": {
    "frequency": 500,
    "enable": true
  },
  "thermal diffusivity": {
    "constant thermal diffusivity": true,
    "base_diffusivity": 1e-2
  },
  "boundary conditions": {
    "T left": 293,
    "T right": 293,
    "T bottom": 293,
    "T top": 293
  },
  "initial temperature": 200,
  "domain": {
    "length": 1,
    "height": 1
  },
  "discretization": {
    "nx dofs": 20,
    "ny dofs": 20
  },
  "time stepping": {
    "end time": 5,
    "time increment": 0.001
  }
}